# Copy to .env and fill in.  Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model (see https://console.groq.com/docs/models). Must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Groq sends real requests/day + tokens/minute (limit, remaining, reset) in its
# response headers, and DevBox shows those. The values below are used before
# the first response and for limits Groq doesn't send (RPM, tokens/day).
# Your organization's numbers: https://console.groq.com/settings/limits
GROQ_PLAN=Free
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000

# --- OpenAI (optional) ------------------------------------------------------
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Empty = use the first chat model on your account. Pick any model in Settings → Model.
OPENAI_MODEL=
# OpenAI sends real requests/minute + tokens/minute in response headers; these
# are only used before the first response. OPENAI_RPD_LIMIT=0 hides the daily meter.
# Your limits: https://platform.openai.com/settings/organization/limits
OPENAI_TIER=Tier 1
OPENAI_RPM_LIMIT=500
OPENAI_TPM_LIMIT=200000
OPENAI_RPD_LIMIT=0

# --- NVIDIA (optional, build.nvidia.com / NIM, OpenAI-compatible) -----------
# Get a key: https://build.nvidia.com  (keys start with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
# Free tier ≈ 40 requests/minute; NVIDIA publishes no token limits (counted locally).
NVIDIA_RPM_LIMIT=40
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# How much gpt-oss models "think" before answering: low | medium | high (empty = provider default)
# DEVBOX_REASONING_EFFORT=low

# Which provider to start with: groq or openai (Settings → Model overrides this)
# LLM_PROVIDER=groq

# --- LangSmith tracing (optional) -------------------------------------------
# Sends prompts + tool results (file paths, process names, ...) to LangSmith.
# Key: https://smith.langchain.com → Settings → API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Project-based workspace:
# LANGSMITH_PROJECT=devbox
# Agent-based workspace (use instead of LANGSMITH_PROJECT):
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=local
# Only if your account is not in the US region, e.g. EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Web UI (always local-only on 127.0.0.1)
# DEVBOX_PORT=8765
# DEVBOX_OPEN_BROWSER=1

# Folders DevBox may scan/change, separated by ';'
# DEVBOX_ALLOWED_ROOTS=%USERPROFILE%\Desktop;%USERPROFILE%\Downloads;%USERPROFILE%\Documents
# DEVBOX_SCAN_TIME_LIMIT=25
