# Copy to .env and fill in.  Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model (see https://console.groq.com/docs/models). Must support tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Groq sends real requests/day + tokens/minute (limit, remaining, reset) in its
# response headers, and DevBox shows those. The values below are used before
# the first response and for limits Groq doesn't send (RPM, tokens/day).
# Your organization's numbers: https://console.groq.com/settings/limits
GROQ_PLAN=Free
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000

# Web UI (always local-only on 127.0.0.1)
# DEVBOX_PORT=8765
# DEVBOX_OPEN_BROWSER=1

# Folders DevBox may scan/change, separated by ';'
# DEVBOX_ALLOWED_ROOTS=%USERPROFILE%\Desktop;%USERPROFILE%\Downloads;%USERPROFILE%\Documents
# DEVBOX_SCAN_TIME_LIMIT=25
